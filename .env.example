# Copy this file to .env and fill in your own values. Never commit .env.

# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Webhook ID shown after you add a sandbox webhook pointing at
#   <BASE_URL>/api/webhooks/events
# Optional: payout status is also polled, so the app works without webhooks.
PAYPAL_WEBHOOK_ID=

# Public URL of this app. Use your ngrok https URL when testing webhooks or
# Log in with PayPal, and add <BASE_URL>/auth/paypal/callback as the app's Return URL.
BASE_URL=http://localhost:3000
PORT=3000

# Any long random string; signs the viewer session cookie.
SESSION_SECRET=change-me-to-a-long-random-string

# Set to true to run the whole app without PayPal credentials (fake PayPal responses).
PAYPAL_MOCK=false
