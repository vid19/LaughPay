# Copy this file to .env and fill in your own values. Never commit .env.

# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Webhook ID shown after you add a sandbox webhook pointing at
#   <BASE_URL>/api/webhooks/events
# Optional: payout status is also polled, so the app works without webhooks.
PAYPAL_WEBHOOK_ID=

# Public URL of this app. Use your ngrok https URL when testing webhooks or
# Log in with PayPal, and add <BASE_URL>/auth/paypal/callback as the app's Return URL.
BASE_URL=http://localhost:3000
PORT=3000

# Any long random string; signs the viewer session cookie.
SESSION_SECRET=change-me-to-a-long-random-string

# Set to true to run the whole app without PayPal credentials (fake PayPal responses).
PAYPAL_MOCK=false

# Claude API key for the AI referee's rulings (console.anthropic.com). Optional:
# without it the referee still detects laughs and uses a rule-based ruling.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# Set to false to send Claude only the numbers, not the peak-moment snapshot.
# REFEREE_SEND_SNAPSHOT=true
# In auto-pay mode, only laughs at or above this peak score pay out without a click.
# REFEREE_AUTOPAY_MIN_PEAK=0.7

# Optional TURN server for the built-in video call on strict networks
# (STUN alone works on most home and campus Wi-Fi).
# TURN_URL can list several addresses separated by commas, e.g. from Metered:
# TURN_URL=turn:standard.relay.metered.ca:80,turn:standard.relay.metered.ca:80?transport=tcp,turn:standard.relay.metered.ca:443,turns:standard.relay.metered.ca:443?transport=tcp
# TURN_USERNAME=
# TURN_CREDENTIAL=
